# ADMIN_USERNAME: Nome de usuário para acesso à Área Administrativa (/admin).
# No Render, defina em "Environment" -> "Add Environment Variable". Padrão: admin
ADMIN_USERNAME="admin"

# ADMIN_PASSWORD: Senha forte para acesso à Área Administrativa (/admin).
# Recomenda-se definir uma senha longa e exclusiva.
ADMIN_PASSWORD="sua-senha-admin-secreta-2025"

# ACCESS_PIN: PIN numérico ou alfanumérico para acesso dos leitores aos livros e Bíblia.
# No Render, defina em "Environment" -> "Add Environment Variable".
# Suporta também 'PIN'. Caso não definido, utiliza o valor padrão inicial: 1234
ACCESS_PIN="1234"

# SESSION_SECRET: Chave secreta usada pelo servidor para assinar sessões e hashes em tempo constante.
SESSION_SECRET="sua-chave-secreta-aleatoria-render"

# DATA_DIR: Diretório para armazenamento persistente das configurações de segurança (PIN, bloqueio).
# No Render, caso utilize Render Disk persistente montado em /var/data, aponte para /var/data.
DATA_DIR="./data"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
